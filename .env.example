# Local dev: run 'supabase status' to get real ANON + SERVICE_ROLE keys.
# Copy this file to .env and paste values in. Never commit .env.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
VITE_GA4_ID=your-ga4-id
VITE_HUBSPOT_PORTAL_ID=your-hubspot-portal-id
HUBSPOT_PORTAL_ID=your-hubspot-portal-id
HUBSPOT_FORM_ID=your-hubspot-form-id
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_PAGES_PROJECT=your-cloudflare-pages-project
WEB3FORMS_KEY=your-web3forms-key
BREVO_API_KEY=your-brevo-key
BOTPRESS_KEY=your-botpress-key
CLOUDINARY_URL=your-cloudinary-url
SENTRY_DSN=your-sentry-dsn
