# Cloudflare Turnstile
# Get these from: https://dash.cloudflare.com/account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEz2yx3ZXwITuXma
TURNSTILE_SECRET_KEY=your_cloudflare_secret_key

# Supabase
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare Pages Environment Variables
# Set these in Cloudflare Dashboard → Pages → rhproject-landing → Settings → Environment variables
# For local development, copy this file to .env.local and fill in the values
# For Cloudflare Pages deployment, set these in the dashboard (not in wrangler.toml for security)
