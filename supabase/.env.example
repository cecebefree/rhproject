# Supabase Local Development
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Stripe (for testing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# PayPal (sandbox mode)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Site URL (for payment redirect links)
SITE_URL=http://localhost:5173

# Brevo (Email)
BREVO_API_KEY=your-brevo-key

# Zadarma (SMS + Calls) — TODO: account not yet created
# Register at: https://zadarma.com/registration/
# API keys at: https://my.zadarma.com/api/
ZADARMA_USER_KEY=your-zadarma-user-key
ZADARMA_SECRET_KEY=your-zadarma-secret-key

# EF-to-EF Auth (Desk Service Identity)
# Generate secrets with: openssl rand -hex 32
EF_FRONT_DESK_SERVICE_NAME=front_desk
EF_FRONT_DESK_SERVICE_SECRET=<generate-with-openssl-rand-hex-32>
EF_FRONT_DESK_SERVICE_SECRET_PREV=

EF_OFFICE_DESK_SERVICE_NAME=office_desk
EF_OFFICE_DESK_SERVICE_SECRET=<generate-with-openssl-rand-hex-32>
EF_OFFICE_DESK_SERVICE_SECRET_PREV=

EF_SCHOOL_DESK_SERVICE_NAME=school_desk
EF_SCHOOL_DESK_SERVICE_SECRET=<generate-with-openssl-rand-hex-32>
EF_SCHOOL_DESK_SERVICE_SECRET_PREV=
